+// PROBE ONLY (PR 4532 review): stands in for slackSend. Never contacts Slack.
+def cpuSlackStub(Map args) {
+    def mode = (params.SLACK_STUB ?: 'ok').toString().trim()
+    echo "PROBE slackSend stub mode=${mode} channel=${args.channel} messageLength=${(args.message ?: '').toString().length()}"
+    if (mode == 'null') {
+        return null
+    }
+    if (mode == 'throw') {
+        throw new RuntimeException('probe stub: simulated slackSend exception')
+    }
+    def ts = "1700000000.0000${env.BUILD_NUMBER}".toString()
+    return [channelId: 'CPROBE000', ts: ts, threadId: "CPROBE000:${ts}".toString()]
+}
