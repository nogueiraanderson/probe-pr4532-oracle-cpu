+def _allowed(url: str) -> bool:
+    """Only https on oracle.com. Page links and redirects choose what is fetched."""
+    parts = urllib.parse.urlsplit(url)
+    host = (parts.hostname or "").lower()
+    return parts.scheme == "https" and (host == "oracle.com" or host.endswith(".oracle.com"))
