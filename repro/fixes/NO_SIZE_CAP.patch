+def _read_body(resp) -> bytes:
+    """Read at most MAX_BODY bytes. A larger body is a fetch error, not data."""
+    chunks: list[bytes] = []
+    total = 0
+    while True:
+        chunk = resp.read(1024 * 1024)
+        if not chunk:
+            return b"".join(chunks)
+        total += len(chunk)
+        if total > MAX_BODY:
+            raise http.client.HTTPException(f"response body exceeds {MAX_BODY} bytes")
